{
  "name": "foundry-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @humber-foundry/reference-site",
    "build:worker": "npm run cloudflare:build --workspace @humber-foundry/reference-site",
    "deploy": "npm run deploy --workspace @humber-foundry/reference-site",
    "dev": "npm run dev --workspace @humber-foundry/reference-site",
    "preview": "npm run preview --workspace @humber-foundry/reference-site",
    "release:prepare": "node scripts/prepare-foundation-release.mjs",
    "release:prepare:local": "node scripts/prepare-foundation-release.mjs --allow-dirty",
    "release:publish": "node scripts/publish-foundation-release.mjs",
    "release:verify": "node scripts/verify-foundation-release.mjs",
    "provision:deployment-baseline": "npm run provision:deployment-baseline --workspace @humber-foundry/reference-site",
    "generate:site-validator": "npm run generate:validator --workspace @humber-foundry/site-definition",
    "graphify:query": "node scripts/graphify-index.mjs query",
    "graphify:refresh": "node scripts/graphify-index.mjs refresh",
    "graphify:status": "node scripts/graphify-index.mjs status",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts && node scripts/verify-private-dashboard-browser.mjs && node scripts/verify-media-gallery-browser.mjs && node scripts/verify-page-photo-change-browser.mjs && node scripts/verify-blog-post-images-browser.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project apps/reference-site/tsconfig.json",
    "verify:integrity": "node scripts/verify-repository-integrity.mjs",
    "verify:mcp:conformance": "node scripts/run-mcp-conformance.mjs",
    "verify:mcp:inspector": "RUN_MCP_INSPECTOR=1 vitest run apps/reference-site/src/mcp-http-runtime.test.ts -t 'pinned official MCP Inspector'",
    "verify:site-validator": "npm run generate:validator --workspace @humber-foundry/site-definition -- --check",
    "verify:bundle": "node scripts/verify-public-bundle.mjs",
    "verify:worker": "node scripts/verify-worker-runtime.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.12.1",
  "devDependencies": {
    "@hyperjump/json-schema": "1.17.8",
    "esbuild": "0.28.1",
    "@modelcontextprotocol/inspector": "2.1.0",
    "@types/commonmark": "0.27.10",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "ajv": "8.20.0",
    "commonmark": "0.31.2",
    "playwright": "1.56.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
