{
  "name": "@foundry/reference-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cloudflare:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:serve": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply foundry-reference-site --local && wrangler d1 migrations apply foundry-reference-site-form-recovery --local --config wrangler.recovery.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply foundry-reference-site --remote && wrangler d1 migrations apply foundry-reference-site-form-recovery --remote --config wrangler.recovery.jsonc",
    "forms:restore": "node scripts/run-public-form-recovery.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@foundry/application": "0.1.0",
    "@foundry/site-definition": "0.1.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@tiptap/react": "3.29.1",
    "@tiptap/starter-kit": "3.29.1",
    "jose": "6.2.4",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "wrangler": "4.114.0"
  }
}
